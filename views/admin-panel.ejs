<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Panel - Tasko</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/responsive.css">
</head>
<body>
    <nav class="navbar">
        <div class="navbar-container">
            <div class="navbar-logo">
                <a href="/">📋 Tasko</a>
            </div>
            <ul class="navbar-menu">
                <li><a href="/dashboard">Dashboard</a></li>
                <li><a href="/admin-panel">Admin Panel</a></li>
                <li><a href="/my-tasks">My Tasks</a></li>
                <li>
                    <span class="notification-icon" onclick="toggleNotifications()">
                        🔔
                        <span id="unreadCount" class="unread-badge" style="display: none;">0</span>
                    </span>
                    <div id="notificationDropdown" class="notification-dropdown" style="display: none;">
                        <div class="notification-header">
                            <h3>Notifications</h3>
                            <button onclick="markAllAsRead()" class="btn btn-small">Mark All Read</button>
                        </div>
                        <div id="notificationList" class="notification-list"></div>
                    </div>
                </li>
                <li><span class="navbar-user"><%= user.name %></span></li>
                <li><a href="/api/auth/logout" class="logout-btn">Logout</a></li>
            </ul>
        </div>
    </nav>

    <main class="main-content">
        <div class="admin-panel">
            <div class="admin-header">
                <h1>👨‍💼 Admin Panel</h1>
                <p>Manage employees and task requests</p>
            </div>

            <div class="admin-stats">
                <div class="stat-card">
                    <h3>Total Employees</h3>
                    <p class="stat-number" id="totalEmployees">-</p>
                </div>
                <div class="stat-card">
                    <h3>Total Tasks</h3>
                    <p class="stat-number" id="totalTasks">-</p>
                </div>
                <div class="stat-card">
                    <h3>Completed Tasks</h3>
                    <p class="stat-number" id="completedTasks">-</p>
                </div>
                <div class="stat-card">
                    <h3>Pending Tasks</h3>
                    <p class="stat-number" id="pendingTasks">-</p>
                </div>
            </div>

            <div class="admin-sections">
                <div class="section">
                    <h2>📋 Pending Task Requests</h2>
                    <div id="taskRequestsList" class="requests-container">
                        <p class="loading">Loading...</p>
                    </div>
                </div>

                <div class="section">
                    <h2>👥 All Employees</h2>
                    <div id="employeesList" class="employees-container">
                        <p class="loading">Loading...</p>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <footer class="footer">
        <p>&copy; 2026 Tasko. All rights reserved.</p>
    </footer>

    <script src="/js/main.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            loadAdminStats();
            loadTaskRequests();
            loadEmployees();
            loadNotifications();
            
            // Load notifications every 10 seconds
            setInterval(loadNotifications, 10000);
        });

        function loadAdminStats() {
            fetch('/api/admin/stats')
                .then((response) => response.json())
                .then((data) => {
                    if (data.success) {
                        document.getElementById('totalEmployees').textContent = data.data.totalEmployees;
                        document.getElementById('totalTasks').textContent = data.data.totalTasks;
                        document.getElementById('completedTasks').textContent = data.data.completedTasks;
                        document.getElementById('pendingTasks').textContent = data.data.pendingTasks;
                    }
                })
                .catch((error) => console.error('Error:', error));
        }

        function loadTaskRequests() {
            fetch('/api/task-requests')
                .then((response) => response.json())
                .then((data) => {
                    if (data.success && data.data.length > 0) {
                        const html = data.data.map((request) => `
                            <div class="request-card">
                                <div class="request-header">
                                    <h4>${request.task.title}</h4>
                                    <span class="status-badge pending">Pending</span>
                                </div>
                                <p class="request-info"><strong>Employee:</strong> ${request.employee.name}</p>
                                <p class="request-info"><strong>Email:</strong> ${request.employee.email}</p>
                                <p class="request-comment">${request.comment || 'No comment'}</p>
                                <div class="request-actions">
                                    <button class="btn btn-success" onclick="approveRequest('${request._id}')">✓ Approve</button>
                                    <button class="btn btn-danger" onclick="rejectRequest('${request._id}')">✕ Reject</button>
                                </div>
                            </div>
                        `).join('');
                        document.getElementById('taskRequestsList').innerHTML = html;
                    } else {
                        document.getElementById('taskRequestsList').innerHTML = '<p class="empty-message">No pending requests</p>';
                    }
                })
                .catch((error) => {
                    console.error('Error:', error);
                    document.getElementById('taskRequestsList').innerHTML = '<p class="error">Error loading requests</p>';
                });
        }

        function loadEmployees() {
            fetch('/api/admin/employees')
                .then((response) => response.json())
                .then((data) => {
                    if (data.success && data.data.length > 0) {
                        const html = data.data.map((employee) => `
                            <div class="employee-card" onclick="viewEmployeeDetails('${employee._id}')">
                                <div class="employee-header">
                                    <h4>${employee.name}</h4>
                                    <span class="role-badge">${employee.role}</span>
                                </div>
                                <p>${employee.email}</p>
                                <small>Click to view details</small>
                            </div>
                        `).join('');
                        document.getElementById('employeesList').innerHTML = html;
                    } else {
                        document.getElementById('employeesList').innerHTML = '<p class="empty-message">No employees</p>';
                    }
                })
                .catch((error) => {
                    console.error('Error:', error);
                    document.getElementById('employeesList').innerHTML = '<p class="error">Error loading employees</p>';
                });
        }

        function approveRequest(requestId) {
            const adminComment = prompt('Enter approval comment (optional):');
            
            fetch(`/api/task-requests/${requestId}/approve`, {
                method: 'PUT',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ adminComment: adminComment || '' }),
            })
                .then((response) => response.json())
                .then((data) => {
                    if (data.success) {
                        alert('Task request approved');
                        loadTaskRequests();
                        loadAdminStats();
                    } else {
                        alert('Error: ' + data.message);
                    }
                })
                .catch((error) => {
                    console.error('Error:', error);
                    alert('An error occurred');
                });
        }

        function rejectRequest(requestId) {
            const adminComment = prompt('Enter rejection reason:');
            if (!adminComment) return;
            
            fetch(`/api/task-requests/${requestId}/reject`, {
                method: 'PUT',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ adminComment }),
            })
                .then((response) => response.json())
                .then((data) => {
                    if (data.success) {
                        alert('Task request rejected');
                        loadTaskRequests();
                    } else {
                        alert('Error: ' + data.message);
                    }
                })
                .catch((error) => {
                    console.error('Error:', error);
                    alert('An error occurred');
                });
        }

        function viewEmployeeDetails(employeeId) {
            fetch(`/api/admin/employees/${employeeId}`)
                .then((response) => response.json())
                .then((data) => {
                    if (data.success) {
                        const emp = data.data;
                        alert(`
Employee: ${emp.employee.name}
Email: ${emp.employee.email}

Task Statistics:
- Total Tasks: ${emp.taskStats.total}
- Completed: ${emp.taskStats.completed}
- Pending: ${emp.taskStats.pending}

Projects: ${emp.projects.length}
                        `);
                    }
                })
                .catch((error) => console.error('Error:', error));
        }

        function loadNotifications() {
            fetch('/api/notifications')
                .then((response) => response.json())
                .then((data) => {
                    if (data.success) {
                        const unreadCount = data.unreadCount;
                        const badge = document.getElementById('unreadCount');
                        
                        if (unreadCount > 0) {
                            badge.textContent = unreadCount;
                            badge.style.display = 'inline-block';
                        } else {
                            badge.style.display = 'none';
                        }

                        if (data.data.length > 0) {
                            const html = data.data.map((notif) => `
                                <div class="notification-item ${notif.isRead ? '' : 'unread'}">
                                    <div class="notif-content">
                                        <strong>${notif.title}</strong>
                                        <p>${notif.message}</p>
                                        <small>${new Date(notif.createdAt).toLocaleDateString()}</small>
                                    </div>
                                    ${!notif.isRead ? `<button class="btn btn-small" onclick="markNotificationRead('${notif._id}')">Mark Read</button>` : ''}
                                </div>
                            `).join('');
                            document.getElementById('notificationList').innerHTML = html;
                        } else {
                            document.getElementById('notificationList').innerHTML = '<p class="empty-message">No notifications</p>';
                        }
                    }
                })
                .catch((error) => console.error('Error:', error));
        }

        function toggleNotifications() {
            const dropdown = document.getElementById('notificationDropdown');
            dropdown.style.display = dropdown.style.display === 'none' ? 'block' : 'none';
        }

        function markNotificationRead(notificationId) {
            fetch(`/api/notifications/${notificationId}/read`, {
                method: 'PUT',
            })
                .then((response) => response.json())
                .then((data) => {
                    if (data.success) {
                        loadNotifications();
                    }
                })
                .catch((error) => console.error('Error:', error));
        }

        function markAllAsRead() {
            fetch('/api/notifications/read-all', {
                method: 'PUT',
            })
                .then((response) => response.json())
                .then((data) => {
                    if (data.success) {
                        loadNotifications();
                    }
                })
                .catch((error) => console.error('Error:', error));
        }
    </script>
</body>
</html>
