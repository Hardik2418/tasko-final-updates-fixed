<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tasko</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/responsive.css">
</head>
<body>
    <nav class="navbar">
        <div class="navbar-container">
            <div class="navbar-logo">
                <a href="/">📋 Tasko</a>
            </div>
            <ul class="navbar-menu">
                <li><a href="/login">Login</a></li>
                <li><a href="/signup" class="signup-btn">Sign Up</a></li>
            </ul>
        </div>
    </nav>

    <main class="main-content">
        <section class="hero">
            <div class="hero-content">
                <h1>Tasko</h1>
                <p>A collaborative application to manage team projects and tasks efficiently</p>
                <div class="hero-buttons">
                    <a href="/signup" class="btn btn-primary">Get Started</a>
                    <a href="/login" class="btn btn-secondary">Login</a>
                </div>
            </div>
        </section>

        <section class="features">
            <div class="features-container">
                <div class="feature">
                    <h3>👥 Team Collaboration</h3>
                    <p>Create projects and invite team members to collaborate in real-time</p>
                </div>
                <div class="feature">
                    <h3>✅ Task Management</h3>
                    <p>Create, assign, and track tasks with priority levels and due dates</p>
                </div>
                <div class="feature">
                    <h3>📊 Dashboard</h3>
                    <p>Get an overview of all your projects and tasks at a glance</p>
                </div>
                <div class="feature">
                    <h3>🔐 Secure</h3>
                    <p>Your data is protected with secure authentication and authorization</p>
                </div>
            </div>
        </section>
    </main>

    <footer class="footer">
        <p>&copy; 2026 Tasko. All rights reserved.</p>
    </footer>

    <script src="/js/main.js"></script>
</body>
</html>
