<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - Tasko</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/responsive.css">
</head>
<body>
    <nav class="navbar">
        <div class="navbar-container">
            <div class="navbar-logo">
                <a href="/">📋 Tasko</a>
            </div>
            <ul class="navbar-menu">
                <li><a href="/dashboard">Dashboard</a></li>
                <% if (isAdmin) { %>
                    <li><a href="/admin-panel">Admin Panel</a></li>
                <% } %>
                <li><a href="/projects">Projects</a></li>
                <li><a href="/my-tasks">My Tasks</a></li>
                <% if (isAdmin) { %>
                    <li>
                        <span class="notification-icon" onclick="toggleNotifications()">
                            🔔
                            <span id="unreadCount" class="unread-badge" style="display: none;">0</span>
                        </span>
                        <div id="notificationDropdown" class="notification-dropdown" style="display: none;">
                            <div class="notification-header">
                                <h3>Notifications</h3>
                                <button onclick="markAllAsRead()" class="btn btn-small">Mark All Read</button>
                            </div>
                            <div id="notificationList" class="notification-list"></div>
                        </div>
                    </li>
                <% } %>
                <li><span class="navbar-user"><%= user.name %> <span style="color: #888;">(<%= user.role === 'admin' ? 'Admin' : 'Employee' %>)</span></span></li>
                <li><a href="/api/auth/logout" class="logout-btn">Logout</a></li>
            </ul>
        </div>
    </nav>

    <main class="main-content">
        <div class="dashboard-container">
            <h1>Welcome, <%= user.name %>!</h1>
            
            <section class="stats-section">
                <div class="stat-card">
                    <h3>Projects</h3>
                    <p class="stat-number"><%= projects.length %></p>
                </div>
                <div class="stat-card">
                    <h3>My Tasks</h3>
                    <p class="stat-number"><%= myTasksCount %></p>
                </div>
                <div class="stat-card alert">
                    <h3>Overdue Tasks</h3>
                    <p class="stat-number"><%= overdueCount %></p>
                </div>
            </section>

            <section class="quick-actions">
                <h2>Quick Actions</h2>
                <div class="actions-buttons">
                    <% if (isAdmin) { %>
                        <button class="btn btn-primary" onclick="showCreateProjectForm()">+ New Project</button>
                    <% } %>
                    <a href="/my-tasks" class="btn btn-secondary">View My Tasks</a>
                </div>
            </section>

            <section class="projects-section">
                <h2>Your Projects</h2>
                <% if (projects.length > 0) { %>
                    <div class="projects-grid">
                        <% projects.forEach(project => { %>
                            <div class="project-card">
                                <h3><%= project.name %></h3>
                                <p><%= project.description %></p>
                                <p class="project-meta">Members: <%= project.members.length %></p>
                                <a href="/projects/<%= project._id %>" class="btn btn-small">View Details</a>
                            </div>
                        <% }); %>
                    </div>
                <% } else { %>
                    <p class="empty-message"><% if (isAdmin) { %>No projects yet. <a href="#" onclick="showCreateProjectForm()">Create one</a><% } else { %>No projects assigned yet.<% } %></p>
                <% } %>
            </section>
        </div>

        <% if (isAdmin) { %>
        <div id="createProjectModal" class="modal" style="display: none;">
            <div class="modal-content">
                <span class="close" onclick="closeModal('createProjectModal')">&times;</span>
                <h2>Create New Project</h2>
                <form id="createProjectForm" class="form">
                    <div class="form-group">
                        <label for="projectName">Project Name</label>
                        <input type="text" id="projectName" name="name" required>
                    </div>
                    <div class="form-group">
                        <label for="projectDescription">Description</label>
                        <textarea id="projectDescription" name="description" rows="4"></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary">Create Project</button>
                </form>
            </div>
        </div>
        <% } %>
    </main>

    <footer class="footer">
        <p>&copy; 2026 Tasko. All rights reserved.</p>
    </footer>

    <script src="/js/main.js"></script>
    <script src="/js/dashboard.js"></script>
    <script>
        // Load notifications if admin
        <% if (isAdmin) { %>
        document.addEventListener('DOMContentLoaded', function () {
            loadNotifications();
            setInterval(loadNotifications, 10000);
        });

        function loadNotifications() {
            fetch('/api/notifications')
                .then((response) => response.json())
                .then((data) => {
                    if (data.success) {
                        const unreadCount = data.unreadCount;
                        const badge = document.getElementById('unreadCount');
                        
                        if (unreadCount > 0) {
                            badge.textContent = unreadCount;
                            badge.style.display = 'inline-block';
                        } else {
                            badge.style.display = 'none';
                        }

                        if (data.data.length > 0) {
                            const html = data.data.map((notif) => `
                                <div class="notification-item ${notif.isRead ? '' : 'unread'}">
                                    <div class="notif-content">
                                        <strong>${notif.title}</strong>
                                        <p>${notif.message}</p>
                                        <small>${new Date(notif.createdAt).toLocaleDateString()}</small>
                                    </div>
                                    ${!notif.isRead ? `<button class="btn btn-small" onclick="markNotificationRead('${notif._id}')">Mark Read</button>` : ''}
                                </div>
                            `).join('');
                            document.getElementById('notificationList').innerHTML = html;
                        } else {
                            document.getElementById('notificationList').innerHTML = '<p class="empty-message">No notifications</p>';
                        }
                    }
                })
                .catch((error) => console.error('Error:', error));
        }

        function toggleNotifications() {
            const dropdown = document.getElementById('notificationDropdown');
            dropdown.style.display = dropdown.style.display === 'none' ? 'block' : 'none';
        }

        function markNotificationRead(notificationId) {
            fetch(`/api/notifications/${notificationId}/read`, {
                method: 'PUT',
            })
                .then((response) => response.json())
                .then((data) => {
                    if (data.success) {
                        loadNotifications();
                    }
                })
                .catch((error) => console.error('Error:', error));
        }

        function markAllAsRead() {
            fetch('/api/notifications/read-all', {
                method: 'PUT',
            })
                .then((response) => response.json())
                .then((data) => {
                    if (data.success) {
                        loadNotifications();
                    }
                })
                .catch((error) => console.error('Error:', error));
        }
        <% } %>
    </script>
</body>
</html>
